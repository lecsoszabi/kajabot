DISCORD_TOKEN=
CLIENT_ID=
# Opcionális: ha ki van töltve, a parancsok csak ebben a szerverben regisztrálódnak
# (fejlesztés közben ez sokkal gyorsabb, mint a globális regisztráció)
GUILD_ID=

# A napi 10 órás poszt célcsatornáját és a kiemelt éttermeket a /setup parancs állítja be
# szerverenként (data/guild-config.json-ba mentve), nincs hozzá .env változó.

# Opcionális: kis RAM-os hosztingon (pl. Fly.io ingyenes 256 MB-os géptípus) állítsd be, hogy a
# bot ne futtasson Puppeteert/Chromiumot — helyette erről a nyers URL-ről olvassa a Famous heti
# menüjét (amit egy GitHub Actions workflow frissít külön, ütemezve). Ha üresen hagyod, a bot
# maga scrapel Puppeteerrel, ahogy alapból is.
# FAMOUS_DATA_URL=https://raw.githubusercontent.com/lecsoszabi/kajabot/main/data/famous-week.json
